#!/usr/bin/env bash
# Aborts a commit when a credential from backend/.env appears in staged content.
#
# DB_HOST is deliberately not scanned: 107.109.131.68 is the documented deployment host and
# appears in README.md and docker-compose.yml by design. DB_USER is not scanned either,
# because a generic account name matches ordinary prose. The password and any other secret
# value are what must never be committed.
set -u

env_file="backend/.env"
status=0

if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo "SECRET LEAK: a .env file is staged" >&2
  status=1
fi

if [ -f "$env_file" ]; then
  staged=$(git diff --cached)
  if [ -n "$staged" ]; then
    while IFS='=' read -r key value; do
      case "$key" in ''|\#*) continue ;; esac
      [ -n "${value:-}" ] || continue
      case "$key" in
        DB_PASSWORD|DB_SECRET|*_TOKEN|*_KEY|*_SECRET) ;;
        *) continue ;;
      esac
      if printf '%s' "$staged" | grep -qF -- "$value"; then
        echo "SECRET LEAK: the value of $key appears in staged content" >&2
        status=1
      fi
    done < "$env_file"
  fi
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact || status=1
fi

exit $status
