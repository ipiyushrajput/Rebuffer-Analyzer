[Unit]
Description=StreamLens — backend
Documentation=https://github.com/ipiyushrajput/Rebuffer-Analyzer
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=rba
Group=rba
WorkingDirectory=/opt/rba/backend

# Credentials live only in this file, which is root-owned and mode 0600.
EnvironmentFile=/opt/rba/backend/.env
# Chromium for PDF export, installed here by install.sh: ProtectHome hides root's cache.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/rba/browsers

ExecStart=/opt/rba/backend/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port ${RBA_PORT} \
    --workers 1 \
    --timeout-graceful-shutdown 30 \
    --no-access-log

# One worker on purpose: a realtime run and its WebSocket live in the process that started
# it. To run more, add instances behind the load balancer; job leases keep each job on one.

Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=45

# Twenty concurrent aging jobs fit inside this comfortably; the cap stops a runaway job
# from taking the host down with it.
MemoryMax=6G
MemoryHigh=5G
TasksMax=4096
LimitNOFILE=65535

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/rba

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rba-backend

[Install]
WantedBy=multi-user.target
