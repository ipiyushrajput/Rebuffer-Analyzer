# Copy to backend/.env and fill in. backend/.env is git-ignored and never committed.

# --- Database ---------------------------------------------------------------
# Everything RBA records lives here: jobs, findings, incidents, samples, playlist
# snapshots, settings and the rendered reports themselves.
#
# DB_ENGINE : mysql | mariadb | postgres | sqlite
#             sqlite keeps a local file in RBA_DATA_DIR and needs nothing else set.
# DB_NAME   : the database RBA creates and owns. It never touches another
#             application's tables.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=rba

# Set when the DB user cannot create databases: every RBA table is then created
# inside DB_NAME with this prefix instead of in a dedicated database.
DB_TABLE_PREFIX=

# --- Service ----------------------------------------------------------------
RBA_HOST=0.0.0.0
RBA_PORT=8010
RBA_PUBLIC_ORIGIN=
RBA_CORS_ORIGINS=http://107.109.131.68:8080,http://localhost:5173

# --- Storage ----------------------------------------------------------------
# Where a rendered report lives.
#   database : the bytes go in the reports table and nothing is written to the
#              host. The default, and what a multi-instance deployment needs.
#   both     : the database, plus a mirrored copy in RBA_REPORTS_DIR.
#   disk     : files only, as older builds behaved.
RBA_REPORT_STORAGE=database

# Only used by sqlite (RBA_DATA_DIR) and by the disk mirror (RBA_REPORTS_DIR).
# Evidence archives are built in memory and streamed, so RBA_EVIDENCE_DIR is unused
# unless a future build writes them out.
RBA_DATA_DIR=./var
RBA_REPORTS_DIR=./var/reports
RBA_EVIDENCE_DIR=./var/evidence

# --- Limits -----------------------------------------------------------------
RBA_MAX_CONCURRENT_JOBS=20
RBA_BULK_DEFAULT_CONCURRENCY=5
RBA_PER_HOST_CONNECTIONS=8
RBA_SAMPLE_RETENTION_DAYS=30

# --- CASCADA ----------------------------------------------------------------
# The field rebuffering metric. CASCADA sits behind the corporate identity provider and
# that provider requires MFA, so the analyzer carries a session rather than logging in.
# Leave these empty and paste a session in the Settings tab instead; set them to pin the
# identity a deployment's calls go out as. The real values belong in backend/.env, which is
# git-ignored, and never here.
CASCADA_BASE_URL=https://cascada.samsungcloud.tv
CASCADA_SESSIONID=
CASCADA_CSRFTOKEN=
CASCADA_TIMEOUT_S=60
# Extra rows beyond the window's own minute count, so a window that grows between the
# request and the answer is still served whole.
CASCADA_ROW_LIMIT_MARGIN=600

# --- DRM --------------------------------------------------------------------
# A protected channel is analysed exactly like a clear one and nothing about DRM is asked
# of an analyst per channel. What a deployment configures, once, is below. Leave these
# empty and fill them in Settings → DRM instead, which stores them in the settings table;
# set them here to pin them to the host.
#
# The three CPIX values are a *location* — a path on this host or an HTTPS URL — never key
# material. No certificate, private key or content key belongs in this file or in git.
# Keep the private key behind authentication: whoever can read it can read every content
# key this deployment obtains.
RBA_DRM_ENABLED=true
# The Widevine licence server the player acquires a licence from. The browser never reaches
# it: POST /api/drm/license relays the challenge from this host.
DRM_LICENSE_URL=
# The CPIX key server. Empty uses the KeyOS v4 endpoint.
CPIX_ENDPOINT=
CPIX_CLIENT_CERT=
CPIX_CLIENT_KEY=
CPIX_SERVER_CERT=
CPIX_CONTENT_ID=rba
